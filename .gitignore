# ==========================================
# 資料快取目錄 (Data Caches)
# ==========================================
yahoo_tw_cache/
twse_daily_cache/
tmp/
logs/
*.log

# ==========================================
# 測試與除錯暫存目錄 (QA & Scratch Dirs)
# ==========================================
qa/invalid_outputs/
qa/pdf_previews/
qa_global_*/
qa_personal_*/

# ==========================================
# Python & 編譯快取 (Python Caches)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
env/
venv/
.env

# ==========================================
# 作業系統與編輯器暫存 (OS & IDE Files)
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.vscode/
.idea/

